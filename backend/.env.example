APP_ENV=development
APP_DEBUG=true

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pairly

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Pairly <no-reply@example.com>
MAIL_SUPPRESS_SEND=false

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
SUPER_ADMIN_NAME=Super Admin

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_UPLOAD_MB=50
MAX_ROWS_PER_DATASET=1000000
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
