# Pairly backend settings. Copy to .env and fill in. Never commit real values.

# development | production. production refuses to start with the example secrets below.
# (FLASK_ENV / FLASK_DEBUG are still read as fallbacks for older .env files.)
APP_ENV=development
APP_DEBUG=true

# Long random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# PostgreSQL, or leave empty to use a local SQLite file (backend/data/app.sqlite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pairly
# Where uploaded datasets and exports are stored (default: backend/data)
# DATA_DIR=

# --- AI (optional; without a key Pairly shows template summaries) ---
# groq | gemini | none. Leave empty to use the first provider that has a key.
LLM_PROVIDER=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model override, e.g. llama-3.3-70b-versatile (Groq) or gemini-2.5-flash (Gemini)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Default for the super admin's platform switch, and requests per store per day
AI_ENABLED=true
AI_DAILY_REQUEST_LIMIT=50

# --- Email (set MAIL_SUPPRESS_SEND=true to log instead of sending) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Pairly <no-reply@example.com>
MAIL_SUPPRESS_SEND=true

# Created on startup if missing
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
SUPER_ADMIN_NAME=Super Admin

# Frontend address (used in emails and always allowed by CORS)
FRONTEND_URL=http://localhost:5173
# Extra comma-separated CORS origins, and an optional regex for preview deploys
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=

# Demo seed (scripts/seed_demo.py); defaults shown
# DEMO_DATASET_PATH=../data/sample/online_retail_ii_sample.csv
# DEMO_MANAGER_EMAIL=demo@example.com
# DEMO_MANAGER_PASSWORD=Demo@12345

MAX_UPLOAD_MB=50
MAX_ROWS_PER_DATASET=1000000
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
