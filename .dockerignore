**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.env
**/.env.*
!**/.env.example
**/*.sqlite
**/node_modules
frontend/
notebooks/
docs/
data/raw/
backend/data/
backend/tests/
screenshots/
.github/
