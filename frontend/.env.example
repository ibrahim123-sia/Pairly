# Where the browser sends API requests.
# Leave unset in development: '/api' is proxied to http://localhost:5000 by Vite.
# For a separately hosted API, set the full URL including /api, e.g.:
# VITE_API_BASE_URL=https://api.example.com/api
# (Not needed on Cloudflare: the Worker serves the app and the API on one address.)
VITE_API_BASE_URL=

# Dev/preview proxy target (default http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
